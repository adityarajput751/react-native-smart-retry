{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "isolatedModules": true
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "lib",
    "example",
    "node_modules"
  ]
}
